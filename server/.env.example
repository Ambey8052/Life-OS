PORT=5000
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CREDENTIAL_ENCRYPTION_KEY=generate-with-node-crypto-randombytes-32-tohex
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Inbox Brief — Gmail (Google Cloud Console -> OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Defaults to ${CLIENT_ORIGIN}/api/gmail/callback (served through the Vite proxy in dev).
GOOGLE_REDIRECT_URI=http://localhost:5173/api/gmail/callback

# Inbox Brief — AI summaries (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
